---
import AdminLayout from '../../../layouts/admin.astro';
import TaxonomyEdit from '../../../components/manage/TaxonomyEdit';
import type { PlaceType } from '../../../shared/types';

export const prerender = false;
const { id } = Astro.params;
const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/admin/placetype/${id}`);
const item: PlaceType = await response.json();
---

<AdminLayout title={`Edit ${item.name}`}>
  <TaxonomyEdit
    item={item}
    apiBase="/api/admin/placetype"
    listPath="/manage/types"
    entityLabel="Type"
    client:load
  />
</AdminLayout>
