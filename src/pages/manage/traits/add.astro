---
import AdminLayout from '../../../layouts/admin.astro';
import TaxonomyEdit from '../../../components/manage/TaxonomyEdit';

export const prerender = false;
const placeholder = { id: 0, name: '', description: '', internalNotes: '', active: true, exclude: false };
---

<AdminLayout title="Add Trait">
  <TaxonomyEdit
    item={placeholder}
    apiBase="/api/admin/trait"
    listPath="/manage/traits"
    entityLabel="Trait"
    showExclude={true}
    client:load
  />
</AdminLayout>
