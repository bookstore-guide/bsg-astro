---
import AdminLayout from '../../../layouts/admin.astro';
import TaxonomyEdit from '../../../components/manage/TaxonomyEdit';
import type { Neighborhood } from '../../../shared/types';

export const prerender = false;
const { id } = Astro.params;
const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/admin/neighborhood/${id}`);
const item: Neighborhood = await response.json();
---

<AdminLayout title={`Edit ${item.name}`}>
  <TaxonomyEdit
    item={item}
    apiBase="/api/admin/neighborhood"
    listPath="/manage/neighborhoods"
    entityLabel="Neighborhood"
    client:load
  />
</AdminLayout>
