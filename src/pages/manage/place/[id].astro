---
import AdminLayout from '../../../layouts/admin.astro';
import Place from '../../../components/manage/Place';
import type { Neighborhood, PlaceType, Trait } from '../../../shared/types';

const { id } = Astro.params;
const response = await fetch(import.meta.env.PUBLIC_API_URL + '/api/admin/place/' + id);
const store = await response.json();
const traitResponse = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/admin/traits`);
const traits: Trait[] = await traitResponse.json();
const placeTypeResponse = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/admin/placetypes`);
const placetypes: PlaceType[] = await placeTypeResponse.json();
const neighborhoodResponse = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/admin/neighborhoods`);
const neighborhoods: Neighborhood[] = await neighborhoodResponse.json();
---

<AdminLayout title={`Edit ${store.name}`}>
  <Place store={store} traits={traits} placetypes={placetypes} neighborhoods={neighborhoods} client:load />
</AdminLayout>
