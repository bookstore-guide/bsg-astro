---
const { current } = Astro.props;
---

<nav aria-label="Site">
  {current !== 'Home' && <a href={`${import.meta.env.BSG_BASE_URL}`}>Home</a>}
  {current !== 'Home' && current !== 'About' && <span aria-hidden="true"> - </span>}
  {current !== 'About' && <a href={`${import.meta.env.BSG_BASE_URL}/about`}>About</a>}
</nav>

<style>
  nav a {
    color: rgba(30, 39, 52, 0.8);
    font-weight: 800;
  }
</style>
