---
import { createSlug } from '../../shared/utils';
const { tags, basePath = '/tag' } = Astro.props;
---

<div class="tags">
  {tags && tags.map((tag: { name: string }) => (
    <a class="tag" href={`${basePath}/${createSlug(tag.name)}`}>{tag.name}</a>
  ))}
</div>

<style>
  div.tags {
    margin-top: 0.5rem;
  }
  a.tag {
    background-color: oklch(0.909962 0.008747 17.3174);
    display: inline-block;
    border: 1px solid oklch(0.144788 0 0);
    padding: 1px 4px;
    font-size: 0.875rem;
    margin-right: 0.5rem;
    margin-bottom: 0.25rem;
    box-sizing: border-box;
    color: oklch(0 0 0);
    text-decoration: none;
    white-space: nowrap;
  }

  a.tag:hover {
    background-color: oklch(0.144788 0 0);
    color: oklch(1 0 0);
  }
</style>
